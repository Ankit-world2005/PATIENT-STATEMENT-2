# Copy to server/.env and fill in. server/.env is git-ignored: never commit real secrets.

NODE_ENV=development
PORT=4000
# Public URL of the portal (used in invitation and password-reset links).
APP_URL=http://localhost:5173

# Matches docker-compose.yml for local development.
DATABASE_URL=postgres://mypatient:mypatient_dev_only@localhost:5432/mypatient

# At least 32 random characters. Signs reset/invite links and encrypts authenticator secrets.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

# Behind a load balancer set this to the number of trusted proxy hops (e.g. 1).
TRUST_PROXY=

# Local file storage for PDFs and import files (production: private, encrypted S3).
STORAGE_DIR=storage

# Email configuration (Gmail SMTP or custom provider).
# To use Gmail:
# 1. Turn ON 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Fill in:
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM=My Patient <your-email@gmail.com>
# Development only: also print sign-in codes and links to the API console.
DEV_LOG_EMAIL=true

# Check new passwords against Have I Been Pwned (only a 5-character hash prefix is sent).
BREACHED_PASSWORD_CHECK=true

# --- Development seed accounts (npm run db:seed; refused in production) ---------
# Leave a password empty to have the seed generate and print a random one.
SEED_ADMIN_EMAIL=saurabh@us24solutions.com
SEED_ADMIN_NAME=Saurabh
SEED_ADMIN_PASSWORD=
SEED_SPECIALIST_EMAIL=ankit.k@us24solutions.com
SEED_SPECIALIST_NAME=Ankit K.
SEED_SPECIALIST_PASSWORD=
SEED_CLINIC_USER_EMAIL=ankitkumar87147@gmail.com
SEED_CLINIC_USER_NAME=Ankit Kumar
SEED_CLINIC_USER_PASSWORD=
